# Copiar a .env (que NO se versiona) y completar. En Cloud Run estas variables las inyecta Secret Manager.

# Supabase, usuario propio del módulo (rol modulo_friccion): solo lee la configuración de clientes y regiones.
# Cadena del "Session pooler": postgresql://postgres.<ref>:<CONTRASEÑA>@aws-0-<region>.pooler.supabase.com:5432/postgres
SUPABASE_DB_URL_MODULO=

# Google Cloud: proyecto de BigQuery. La autenticación NO va acá:
#  - local: gcloud auth application-default login
#  - Cloud Run: la cuenta de servicio del Job
GCP_PROJECT=pruebas-pfi

# LLM que elige los eventos clave (Pod de RunPod con vLLM; el módulo lo busca por nombre)
RUNPOD_API_KEY=
VLLM_API_KEY=
LLM_POD_NOMBRE=friccion-llm

# Opcional. Sin MODELOS_BUCKET los modelos se guardan en resultados/modelos/ (local)
# MODELOS_BUCKET=pruebas-pfi-friccion-modelos
