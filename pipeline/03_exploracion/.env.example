# ==============================================================================
# Google Cloud Platform (Proyecto Central de la Plataforma)
# ==============================================================================
PLATFORM_GCP_PROJECT_ID=pruebas-pfi
GOOGLE_APPLICATION_CREDENTIALS=/ruta/a/tu/service-account.json

# BigQuery (Dataset centralizado de detección y exploración de fricción)
DEFAULT_BIGQUERY_REGION=us
BIGQUERY_DATASET=friccion_resultados
BIGQUERY_PATTERNS_TABLE_NAME=patrones
BIGQUERY_SESSIONS_TABLE_NAME=sesion_representativa
BIGQUERY_TABLE_NAME=patrones_friccion_explorados

# Cloud Storage (Bucket único centralizado en US para evidencias fotográficas WebP)
STORAGE_PROVIDER=local
LOCAL_STORAGE_PATH=./evidence_storage
GCS_BUCKET_NAME=pruebas-pfi-evidencias
GCS_LOCATION=us

# ==============================================================================
# Supabase (Uso administrativo backend: lectura de clientes y credenciales)
# ==============================================================================
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu-service-role-key

# ==============================================================================
# Seguridad y Criptografía (AES-256-GCM para descifrado de credenciales de prueba)
# ==============================================================================
AES_ENCRYPTION_KEY=reemplazar_por_clave_hex_64_caracteres_o_base64_32_bytes

# ==============================================================================
# Configuración del Servicio y Navegador
# ==============================================================================
ENVIRONMENT=production
HEADLESS_MODE=true
DEFAULT_TIMEOUT_MS=15000
NAVIGATION_TIMEOUT_MS=30000
PAGE_SETTLE_SECONDS=5.0
MAX_CONCURRENCY_PER_CLIENT=3
MAX_CLIENT_RETRIES=3
