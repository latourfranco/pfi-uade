# Entorno
ENVIRONMENT=production

# Supabase Transaccional
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# GCP / Cloud Storage & BigQuery (Único dataset de resultados y único bucket en US)
PLATFORM_GCP_PROJECT_ID=pruebas-pfi
BIGQUERY_DATASET_ID=friccion_resultados
BIGQUERY_EXPLORATION_TABLE_NAME=patrones_friccion_explorados
BIGQUERY_MODELS_TABLE_NAME=modelos
BIGQUERY_EVENTS_DATASET_ID=dw_analytics_us
BIGQUERY_EVENTS_TABLE_NAME=eventos_usuario
GCS_BUCKET_CAPTURES=pruebas-pfi-evidencias
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# Servicio de Inferencia en RunPod Pod (vLLM - Qwen3.5 con razonamiento)
RUNPOD_API_KEY=your-runpod-api-key
VLLM_API_KEY=your-vllm-api-key
LLM_POD_NOMBRE=friccion-llm
LLM_INFERENCE_URL=
LLM_MODEL_NAME=cyankiwi/Qwen3.5-27B-AWQ-4bit
LLM_TIMEOUT_SECONDS=360.0
LLM_MAX_RETRIES=3
LLM_READY_MAX_WAIT_SECONDS=900.0
LLM_READY_POLL_INTERVAL_SECONDS=15.0
LLM_MAX_TOKENS=8000
LLM_TEMPERATURE=0.2
LLM_ENABLE_THINKING=true
LLM_USER_AGENT=eureka-insights/1.0
