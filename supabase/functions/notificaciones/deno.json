{
  "compilerOptions": {
    "jsx": "react",
    "types": ["npm:@types/react@18.3.1"],
    "strict": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1.0.0",
    "@std/http": "jsr:@std/http@^1.0.0",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@2",
    "@react-email/components": "npm:@react-email/components@0.0.22",
    "react": "npm:react@18.3.1",
    "@types/react": "npm:@types/react@18.3.1"
  },
  "lint": {
    "rules": {
      "tags": ["recommended"]
    },
    "exclude": ["cov_profile/"]
  },
  "fmt": {
    "useTabs": false,
    "lineWidth": 100,
    "indentWidth": 2,
    "singleQuote": false,
    "exclude": ["cov_profile/"]
  },
  "tasks": {
    "test": "deno test --allow-env",
    "coverage": "deno test --allow-env --coverage=cov_profile && deno coverage cov_profile --detailed"
  }
}
